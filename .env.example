# Copy to .env.local and fill in from Supabase → Settings → API
# https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Use the Publishable key (sb_publishable_…) on newer projects:
VITE_SUPABASE_PUBLISHABLE_KEY=

# Or the legacy anon JWT (older projects / docs still call this "anon"):
# VITE_SUPABASE_ANON_KEY=

# --- Seed script only (`npm run seed:tao`) — never expose in the browser ---
# SUPABASE_URL=          # optional; falls back to VITE_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=
